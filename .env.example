# Supabase Configuration (Free Tier)
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Email / Contact API (Resend.com)
# If left empty, the contact form falls back to direct mailto: link
RESEND_API_KEY=
CONTACT_NOTIFICATION_EMAIL=shivkanya.byale@example.com

# Privacy-Friendly Analytics (Optional)
# NEXT_PUBLIC_VERCEL_ANALYTICS=true
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=yourdomain.com
